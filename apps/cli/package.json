{
  "name": "amoeba-cli",
  "version": "0.1.0",
  "description": "⚡ Amoeba Framework CLI - Scaffolding fullstack Go + Frontend apps",
  "type": "module",
  "bin": {
    "amoeba": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "amoeba",
    "cli",
    "scaffolder",
    "fullstack",
    "go",
    "fiber"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
